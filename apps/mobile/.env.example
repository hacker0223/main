# Point this at your machine's LAN IP while developing so a physical device
# running Expo Go can reach the backend (localhost won't work from the phone).
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Optional — accounts (sign up/sign in) are inert until both are set, the
# rest of the app works fine without them. From your Supabase project:
# Settings -> API -> Project URL / anon public key. The anon key is safe to
# ship in the client; it's designed to be public and gated by Row Level
# Security on the backend, not a secret.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
